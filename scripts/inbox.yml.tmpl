# Applies zip uploads: drop a .zip into inbox/ (or the repo root) on github.com and this
# workflow unzips it, checks it, runs the tests, commits it and reports in the "Inbox log" issue.
# This file is generated by scripts/build_inbox_yml.py and embeds scripts/apply_inbox.py so it
# works the very first time, before any other file exists. Paste it once; zips do the rest.
name: Inbox (apply zip uploads)

on:
  push:
    branches: [main]
    paths:
      - 'inbox/*.zip'
      - '*.zip'
  workflow_dispatch:
    inputs:
      zip:
        description: 'Apply only this zip, for example inbox/update.zip (empty = every zip found)'
        required: false
        default: ''
      revert_sha:
        description: 'Revert this commit instead of applying zips (rollback)'
        required: false
        default: ''

concurrency:
  group: inbox
  cancel-in-progress: false

permissions:
  contents: write
  issues: write

jobs:
  apply:
    if: github.actor == github.repository_owner
    runs-on: ubuntu-latest
    timeout-minutes: 30
    env:
      AUTHOR_NAME: ${{ github.repository_owner }}
      AUTHOR_EMAIL: ${{ github.repository_owner_id }}+${{ github.repository_owner }}@users.noreply.github.com
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0
          token: ${{ secrets.INBOX_PAT || github.token }}

      - name: Revert a commit
        if: github.event.inputs.revert_sha != ''
        env:
          REVERT_SHA: ${{ github.event.inputs.revert_sha }}
        run: |
          git -c user.name="$AUTHOR_NAME" -c user.email="$AUTHOR_EMAIL" revert --no-edit "$REVERT_SHA"
          git push origin HEAD:"${GITHUB_REF_NAME}"

      - name: Apply zips
        id: apply
        if: github.event.inputs.revert_sha == ''
        env:
          INBOX_AUTHOR_NAME: ${{ env.AUTHOR_NAME }}
          INBOX_AUTHOR_EMAIL: ${{ env.AUTHOR_EMAIL }}
          HAS_PAT: ${{ secrets.INBOX_PAT != '' }}
          ZIP: ${{ github.event.inputs.zip }}
        run: |
          shopt -s nullglob
          zips=(inbox/*.zip *.zip)
          if [ ${#zips[@]} -eq 0 ] && [ -z "$ZIP" ]; then
            echo "No zip present; nothing to do."
            echo "found=false" >> "$GITHUB_OUTPUT"
            exit 0
          fi
          echo "found=true" >> "$GITHUB_OUTPUT"
          echo "before=$(git rev-parse HEAD)" >> "$GITHUB_OUTPUT"
          script="$RUNNER_TEMP/apply_inbox.py"
          if [ -f scripts/apply_inbox.py ] && python3 -m py_compile scripts/apply_inbox.py; then
            cp scripts/apply_inbox.py "$script"
          else
            echo "Using the embedded copy of apply_inbox.py"
            cat > "$script" <<'PYEOF'
__EMBEDDED__
          PYEOF
          fi
          flags=(--push --report-file "$RUNNER_TEMP/inbox_report.md")
          if [ "$HAS_PAT" = "true" ]; then flags+=(--allow-workflows); fi
          if [ -n "$ZIP" ]; then flags+=(--zip "$ZIP"); fi
          set +e
          python3 "$script" "${flags[@]}"
          rc=$?
          echo "rc=$rc" >> "$GITHUB_OUTPUT"
          exit 0

      - name: Confirm the Vercel deploy
        if: steps.apply.outputs.found == 'true' && steps.apply.outputs.rc == '0'
        env:
          BEFORE: ${{ steps.apply.outputs.before }}
          SITE_URL: ${{ vars.SITE_URL }}
        run: |
          after=$(git rev-parse HEAD)
          if [ "$after" = "$BEFORE" ]; then echo "Nothing new on main."; exit 0; fi
          if ! git diff --name-only "$BEFORE" "$after" | grep -Eq '^(site|api)/|^vercel.json$|^package.json$'; then
            echo "No site or api change, so no deploy is expected."; exit 0
          fi
          if [ -z "$SITE_URL" ]; then
            echo "Tip: set the SITE_URL repository variable (for example https://your-app.vercel.app) so this run can confirm the deploy."
            exit 0
          fi
          for i in $(seq 1 40); do
            body=$(curl -fsS --max-time 15 "$SITE_URL/api/health?ts=$(date +%s)" || true)
            if echo "$body" | grep -q "\"commit\":\"$after\""; then
              echo "Vercel is serving $after."
              echo "- Deploy confirmed: Vercel is serving \`${after:0:7}\`." >> "$RUNNER_TEMP/inbox_report.md"
              exit 0
            fi
            sleep 15
          done
          msg="Vercel did not serve ${after:0:7} within 10 minutes. Check the Vercel dashboard: Hobby blocks deploys when the commit author is not the account owner."
          echo "::warning::$msg"
          echo "- $msg" >> "$RUNNER_TEMP/inbox_report.md"

      - name: Post to the Inbox log issue
        if: always() && steps.apply.outputs.found == 'true'
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          report="$RUNNER_TEMP/inbox_report.md"
          [ -f "$report" ] || exit 0
          echo "" >> "$report"
          echo "Run: $GITHUB_SERVER_URL/$GITHUB_REPOSITORY/actions/runs/$GITHUB_RUN_ID" >> "$report"
          num=$(gh issue list --state open --search 'Inbox log in:title' --json number --jq '.[0].number // empty' || true)
          if [ -z "$num" ]; then
            gh issue create --title "Inbox log" --body-file "$report" || true
          else
            gh issue comment "$num" --body-file "$report" || true
          fi

      - name: Fail the run if a zip failed
        if: steps.apply.outputs.found == 'true' && steps.apply.outputs.rc != '0'
        run: |
          echo "A zip failed. Read the Inbox log issue for the reason."
          exit 1
