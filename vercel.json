{
  "framework": null,
  "buildCommand": null,
  "installCommand": null,
  "outputDirectory": "site",
  "cleanUrls": true,
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- site api vercel.json package.json",
  "functions": { "api/*.js": { "maxDuration": 10 } },
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "no-referrer" } ] }
  ]
}
